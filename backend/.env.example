DATABASE_URL=sqlite:///./set_to_set.db
APP_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Recuperación de contraseña (US-76)
PASSWORD_RESET_URL=http://localhost:5173/restablecer-contrasena
# console: el enlace se escribe en el log del backend. smtp: se envía por correo.
EMAIL_BACKEND=console
EMAIL_FROM="Set to Set <no-reply@settoset.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
