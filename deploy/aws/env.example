# Dominio propio o hostname de sslip.io apuntando a la IP estática de Lightsail.
DOMAIN=203.0.113.10.sslip.io

POSTGRES_DB=set_to_set
POSTGRES_USER=set_to_set
# Generá un valor alfanumérico aleatorio, por ejemplo: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-value
# Generá un secreto independiente: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value

# Datos SMTP de Amazon SES (o de otro proveedor SMTP).
EMAIL_FROM="Set to Set <verified-sender@example.com>"
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-ses-smtp-username
SMTP_PASSWORD=replace-with-ses-smtp-password
SMTP_USE_TLS=true
